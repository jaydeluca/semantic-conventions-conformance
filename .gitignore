.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Raw weaver reports from a run — one JSON per scenario, throwaway. The
# reduction over the whole run (data.json) is committed.
output/
results/

# Gradle: its caches, and everything a scenario's `setup` builds into them.
.gradle/
build/

# npm: the dependency tree a scenario's `setup` installs. The lockfile is committed.
node_modules/

# .NET: what a build writes, which the artifacts output layout collects into
# one directory per build root.
artifacts/

# The time axis, replayed out of git at publish time. A file built from
# history can only describe the commits before the one it would be committed
# in, so committing it would publish a timeline that is always one commit
# stale. See tools/report/src/conformance_report/_history.py.
docs/data/history.json
